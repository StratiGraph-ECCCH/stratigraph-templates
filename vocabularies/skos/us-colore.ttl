# Colour of the deposit — modulo SKOS originato in Extended Matrix (em-us-colore, 0.1.0).
#
# PERCHE' ESISTE. Il modello ICCD US 2021 prescrive per la casella «COLORE»
# un termine controllato, ma l'ICCD non ha pubblicato lo SKOS dei modelli da
# campo (misurato: il .doc del modello porta solo le etichette delle caselle).
# Questo modulo risponde PROVVISORIAMENTE per lo schema dichiarato
# iccd-us-colore: il giorno che l'ICCD pubblica, si aggiunge un allineamento e basta.
#
# DA DOVE VENGONO I TERMINI. Ogni concetto porta la sua fonte (dct:source):
# nessun termine entra senza. Le definizioni sono RIFORMULATE, non trascritte.
# Le etichette it vengono dalle fonti; le altre lingue sono BOZZE non
# verificate (unverified_languages nello scheme yaml): operative subito,
# corrette dopo la verifica.
#
# NAMESPACE. w3id.org/extendedmatrix, come em-taph-weathering (SPEC §3).

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix em:   <https://w3id.org/extendedmatrix/vocab/us-colore/> .

em: a skos:ConceptScheme ;
    dct:title "Colour of the deposit"@en ;
    dct:title "Colore del deposito"@it ;
    dct:description "Colour names for the COLOUR box of a stratigraphic unit sheet (ICCD US 2021), gathered from the PyArchInit thesaurus. Names, not Munsell notations: a Munsell reading stays a free annotation."@en ;
    dct:creator "Extended Matrix — StratiGraph WP3, CNR-ISPC" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" ;
    dct:issued "2026-09-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
    skos:editorialNote "Labels in en, ro, el, es, pl, he, de are drafts, not yet verified by a person who answers for them."@en ;
    skos:hasTopConcept em:arancione, em:azzurro, em:bianco, em:blu, em:giallo, em:giallorosso, em:grigio, em:marrone, em:nero, em:rosato, em:rosso, em:verde .

em:arancione a skos:Concept ; skos:inScheme em: ; skos:topConceptOf em: ;
    skos:prefLabel "arancione"@it ; skos:prefLabel "orange"@en ; skos:prefLabel "portocaliu"@ro ; skos:prefLabel "πορτοκαλί"@el ; skos:prefLabel "naranja"@es ; skos:prefLabel "pomarańczowy"@pl ; skos:prefLabel "כתום"@he ; skos:prefLabel "orange"@de ;
    skos:definition "Colore del deposito percepito come arancione, a occhio nudo e con luce diurna."@it ;
    skos:definition "Colour of the deposit perceived as orange, by eye and in daylight."@en ;
    dct:source "PyArchInit thesaurus, tipologia 201.201, descrizione «Colore di una US» (pyarchinit_thesaurus_sigle, nome_tabella US): sigla Ara «Arancione»" .

em:azzurro a skos:Concept ; skos:inScheme em: ; skos:topConceptOf em: ;
    skos:prefLabel "azzurro"@it ; skos:prefLabel "light blue"@en ; skos:prefLabel "albastru deschis"@ro ; skos:prefLabel "γαλάζιο"@el ; skos:prefLabel "azul claro"@es ; skos:prefLabel "błękitny"@pl ; skos:prefLabel "תכלת"@he ; skos:prefLabel "hellblau"@de ;
    skos:definition "Colore del deposito percepito come azzurro, a occhio nudo e con luce diurna."@it ;
    skos:definition "Colour of the deposit perceived as light blue, by eye and in daylight."@en ;
    dct:source "PyArchInit thesaurus, tipologia 201.201, descrizione «Colore di una US» (pyarchinit_thesaurus_sigle, nome_tabella US): sigla Azz «Azzurro»" .

em:bianco a skos:Concept ; skos:inScheme em: ; skos:topConceptOf em: ;
    skos:prefLabel "bianco"@it ; skos:prefLabel "white"@en ; skos:prefLabel "alb"@ro ; skos:prefLabel "λευκό"@el ; skos:prefLabel "blanco"@es ; skos:prefLabel "biały"@pl ; skos:prefLabel "לבן"@he ; skos:prefLabel "weiß"@de ;
    skos:definition "Colore del deposito percepito come bianco, a occhio nudo e con luce diurna."@it ;
    skos:definition "Colour of the deposit perceived as white, by eye and in daylight."@en ;
    dct:source "PyArchInit thesaurus, tipologia 201.201, descrizione «Colore di una US» (pyarchinit_thesaurus_sigle, nome_tabella US): sigla Bia «Bianco»" .

