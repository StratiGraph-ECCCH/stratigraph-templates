    skos:prefLabel "blu"@it ; skos:prefLabel "blue"@en ; skos:prefLabel "albastru"@ro ; skos:prefLabel "μπλε"@el ; skos:prefLabel "azul"@es ; skos:prefLabel "niebieski"@pl ; skos:prefLabel "כחול"@he ; skos:prefLabel "blau"@de ;
