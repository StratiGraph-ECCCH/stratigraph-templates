    skos:broader em:strato ;
    skos:prefLabel "strato di pietra"@it ; skos:prefLabel "stone layer"@en ; skos:prefLabel "strat de piatră"@ro ; skos:prefLabel "στρώμα λίθων"@el ; skos:prefLabel "estrato de piedra"@es ; skos:prefLabel "warstwa kamieni"@pl ; skos:prefLabel "שכבת אבנים"@he ; skos:prefLabel "Steinschicht"@de ;
