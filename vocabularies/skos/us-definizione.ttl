    skos:definition "A layer made up mainly of gravel."@en ;
    dct:source "PyArchInit thesaurus, tipologia 2.3 «Definizione stratigrafica» (pyarchinit_thesaurus_sigle, nome_tabella US): sigla Stg «Strato di ghiaia»" .

em:strato-di-ciottoli a skos:Concept ; skos:inScheme em: ;
    skos:broader em:strato ;
    skos:prefLabel "strato di ciottoli"@it ; skos:prefLabel "pebble layer"@en ; skos:prefLabel "strat de galeți"@ro ; skos:prefLabel "στρώμα βοτσάλων"@el ; skos:prefLabel "estrato de cantos rodados"@es ; skos:prefLabel "warstwa otoczaków"@pl ; skos:prefLabel "שכבת חלוקי נחל"@he ; skos:prefLabel "Geröllschicht"@de ;
    skos:definition "Strato composto in prevalenza di ciottoli."@it ;
    skos:definition "A layer made up mainly of pebbles."@en ;
    dct:source "PyArchInit thesaurus, tipologia 2.3 «Definizione stratigrafica» (pyarchinit_thesaurus_sigle, nome_tabella US): sigle SC, Stc «Strato di ciottoli»" .

em:strato-di-pietrisco a skos:Concept ; skos:inScheme em: ;
    skos:broader em:strato ;
    skos:prefLabel "strato di pietrisco"@it ; skos:prefLabel "crushed stone layer"@en ; skos:prefLabel "strat de piatră spartă"@ro ; skos:prefLabel "στρώμα θραυστών λίθων"@el ; skos:prefLabel "estrato de piedra triturada"@es ; skos:prefLabel "warstwa tłucznia"@pl ; skos:prefLabel "שכבת אבן גרוסה"@he ; skos:prefLabel "Schotterschicht"@de ;
    skos:definition "Strato composto in prevalenza di pietrisco."@it ;
