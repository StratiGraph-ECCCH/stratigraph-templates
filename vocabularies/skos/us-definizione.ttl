    skos:broader em:strato ;
    skos:prefLabel "strato di cenere"@it ; skos:prefLabel "ash layer"@en ; skos:prefLabel "strat de cenușă"@ro ; skos:prefLabel "στρώμα τέφρας"@el ; skos:prefLabel "estrato de ceniza"@es ; skos:prefLabel "warstwa popiołu"@pl ; skos:prefLabel "שכבת אפר"@he ; skos:prefLabel "Ascheschicht"@de ;
