em:strato-di-ghiaia a skos:Concept ; skos:inScheme em: ;
    skos:broader em:strato ;
    skos:prefLabel "strato di ghiaia"@it ; skos:prefLabel "gravel layer"@en ; skos:prefLabel "strat de pietriș"@ro ; skos:prefLabel "στρώμα χαλικιών"@el ; skos:prefLabel "estrato de grava"@es ; skos:prefLabel "warstwa żwiru"@pl ; skos:prefLabel "שכבת חצץ"@he ; skos:prefLabel "Kiesschicht"@de ;
