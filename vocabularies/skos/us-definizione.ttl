em:strato-di-carbone a skos:Concept ; skos:inScheme em: ;
    skos:broader em:strato ;
    skos:prefLabel "strato di carbone"@it ; skos:prefLabel "charcoal layer"@en ; skos:prefLabel "strat de cărbune"@ro ; skos:prefLabel "στρώμα άνθρακα"@el ; skos:prefLabel "estrato de carbón"@es ; skos:prefLabel "warstwa węgla drzewnego"@pl ; skos:prefLabel "שכבת פחם"@he ; skos:prefLabel "Holzkohleschicht"@de ;
